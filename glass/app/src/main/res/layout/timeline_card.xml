<?xml version="1.0" encoding="utf-8"?>
<!-- StellrGlass's live card on Glass's timeline (TimelineCard.kt). Glass's display is
     640x360; px follows the GDK card guidelines (40px margins). Like the rest of the app,
     English only and left-to-right. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,Overdraw,PxUsage,RtlHardcoded"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextView
        android:id="@+id/timeline_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40px"
        android:layout_marginRight="40px"
        android:layout_marginTop="40px"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        android:maxLines="2"
        android:textColor="#FFFFFF"
        android:textSize="48px" />

    <TextView
        android:id="@+id/timeline_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/timeline_headline"
        android:layout_marginLeft="40px"
        android:layout_marginRight="40px"
        android:layout_marginTop="16px"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        android:maxLines="3"
        android:textColor="#BBBBBB"
        android:textSize="30px" />

    <TextView
        android:id="@+id/timeline_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24px"
        android:layout_marginLeft="40px"
        android:text="StellrGlass"
        android:textColor="#808080"
        android:textSize="24px" />
</RelativeLayout>
